#!/bin/sh
#
# This script runs inside the snap after installation. It creates symlinks for
# voices so that they are located at a static path known at build time (passed
# as the `voices_dir` parameter when building speech-provider-piper).
#
# It also names each voice directory using the format of the .onnx filename
# (e.g. en_US-amy-medium) which piper will use as the voice ID. 
#
set -e

# Target directory inside $SNAP_DATA where speech-provider-piper looks for models
TARGET_DIR="$SNAP_DATA/voices"
mkdir -p "$TARGET_DIR"

# $SNAP_COMPONENT contains the exact path to this component's active mount
# Example: /snap/speech-provider-piper/current/components/mnt/voices-en-us-amy-medium/x1
# The voice ID piper expects (e.g. en_US-amy-medium) is the .onnx file's
# basename, not the component's own name, so derive it from that instead.
if [ -n "$SNAP_COMPONENT" ]; then
    for onnx in "$SNAP_COMPONENT"/*.onnx; do
        [ -e "$onnx" ] || continue
        voice_id=$(basename "$onnx" .onnx)
        ln -sfn "$SNAP_COMPONENT" "$TARGET_DIR/$voice_id"
    done
fi